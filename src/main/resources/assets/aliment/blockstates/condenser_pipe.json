{
  "multipart": [
    {
      "when": { "outlet_down": "false" },
      "apply": { "model": "aliment:block/condenser_pipe_up" }
    },
    {
      "when": { "outlet_down": "true" },
      "apply": { "model": "aliment:block/condenser_pipe_down" }
    },
    {
      "when": { "north": "true" },
      "apply": { "model": "aliment:block/condenser_pipe_side" }
    },
    {
      "when": { "south": "true" },
      "apply": { "model": "aliment:block/condenser_pipe_side", "y": 180 }
    },
    {
      "when": { "west": "true" },
      "apply": { "model": "aliment:block/condenser_pipe_side", "y": 270 }
    },
    {
      "when": { "east": "true" },
      "apply": { "model": "aliment:block/condenser_pipe_side", "y": 90 }
    }
  ]
}
